# Application
NODE_ENV=development
PORT=3001

# PostgreSQL / Prisma
DATABASE_URL="postgresql://admin:CHANGE_ME@localhost:5433/akord_db?schema=public"

# Initial administrator account
SEED_OWNER_EMAIL="admin@example.com"
SEED_OWNER_PASSWORD="CHANGE_ME"
SEED_OWNER_FIRST_NAME="Admin"
SEED_OWNER_LAST_NAME="Admin"

# JWT authentication
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_RANDOM_SECRET"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"