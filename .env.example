# Public ports exposed by Docker Compose
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5433

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=akord_db

# Optional initial CMS owner (used only when the seed command is run)
SEED_OWNER_EMAIL=admin@example.com
SEED_OWNER_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
SEED_OWNER_FIRST_NAME=AKORD
SEED_OWNER_LAST_NAME=Admin

# Authentication — use long, independent random values
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
